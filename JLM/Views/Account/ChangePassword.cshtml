@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Segurança";
    ViewData["Description"] = "Altere sua senha de acesso à conta JLM.";
    ViewData["BodyClass"] = "page-account";
}

<section class="page-intro page-intro--small">
    <div class="container page-intro__inner">
        <div>
            <nav class="breadcrumbs" aria-label="Trilha de navegação">
                <a href="/">Início</a><span>/</span><a href="/conta">Minha conta</a><span>/</span><span aria-current="page">Segurança</span>
            </nav>
            <span class="eyebrow">Conta</span>
            <h1>Senha e <em>segurança.</em></h1>
        </div>
    </div>
</section>

<section class="section account">
    <div class="container account__layout">
        @await Html.PartialAsync("_AccountNav")

        <div class="account__content">
            <div class="account-grid">
                <form action="/conta/senha" method="post" class="account-form account-section">
                    @Html.AntiForgeryToken()
                    <div class="account-section__head">
                        <div><span class="eyebrow">Acesso</span><h2>Alterar senha</h2></div>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="field">
                        <label asp-for="CurrentPassword">Senha atual</label>
                        <div class="input-password">
                            <input asp-for="CurrentPassword" autocomplete="current-password" data-password-input />
                            <button type="button" data-password-toggle aria-label="Mostrar senha"><svg class="icon"><use href="#i-eye"></use></svg></button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="NewPassword">Nova senha</label>
                        <div class="input-password">
                            <input asp-for="NewPassword" autocomplete="new-password" placeholder="Mínimo 8 caracteres" data-password-input />
                            <button type="button" data-password-toggle aria-label="Mostrar senha"><svg class="icon"><use href="#i-eye"></use></svg></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword">Confirmar nova senha</label>
                        <div class="input-password">
                            <input asp-for="ConfirmPassword" autocomplete="new-password" data-password-input />
                            <button type="button" data-password-toggle aria-label="Mostrar senha"><svg class="icon"><use href="#i-eye"></use></svg></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>

                    <div class="account-form__actions">
                        <button type="submit" class="btn btn--gold">Atualizar senha <svg class="icon"><use href="#i-lock"></use></svg></button>
                        <a class="btn btn--ghost" href="/conta">Cancelar</a>
                    </div>
                </form>

                <div class="account-section account-section--security">
                    <span class="eyebrow">Boas práticas</span>
                    <h2>Mantenha sua conta protegida</h2>
                    <ul class="check-list">
                        <li><svg class="icon"><use href="#i-check"></use></svg> Use uma senha exclusiva para a JLM.</li>
                        <li><svg class="icon"><use href="#i-check"></use></svg> Não compartilhe sua senha por e-mail ou WhatsApp.</li>
                        <li><svg class="icon"><use href="#i-check"></use></svg> Saia da conta em dispositivos compartilhados.</li>
                        <li><svg class="icon"><use href="#i-check"></use></svg> A JLM nunca solicita dados de cartão por mensagem.</li>
                    </ul>
                    <div class="security-note">
                        <svg class="icon"><use href="#i-shield"></use></svg>
                        <p>Senhas são armazenadas com hash criptográfico. Nem nossa equipe consegue visualizá-las.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
