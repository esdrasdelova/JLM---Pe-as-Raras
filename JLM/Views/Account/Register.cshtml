@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Criar conta";
}

<div class="auth-card__head">
    <span class="eyebrow">Clube JLM</span>
    <h1>Crie sua<br /><em>assinatura.</em></h1>
    <p>Conta gratuita com acesso antecipado a lançamentos, histórico de pedidos e lista de favoritos sincronizada.</p>
</div>

<form action="/conta/cadastrar" method="post" class="auth-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="field">
        <label asp-for="FullName">Nome completo</label>
        <input asp-for="FullName" autocomplete="name" placeholder="Seu nome" autofocus />
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>

    <div class="form-grid">
        <div class="field">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="voce@email.com" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Phone">Telefone</label>
            <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="(11) 99999-9999" data-mask-phone />
            <span asp-validation-for="Phone" class="field-error"></span>
        </div>
    </div>

    <div class="form-grid">
        <div class="field">
            <label asp-for="Password">Senha</label>
            <div class="input-password">
                <input asp-for="Password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" data-password-input />
                <button type="button" data-password-toggle aria-label="Mostrar senha"><svg class="icon"><use href="#i-eye"></use></svg></button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Confirmar senha</label>
            <div class="input-password">
                <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repita a senha" data-password-input />
                <button type="button" data-password-toggle aria-label="Mostrar senha"><svg class="icon"><use href="#i-eye"></use></svg></button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <label class="check check--terms">
        <input asp-for="AcceptTerms" />
        <span>Li e aceito os <a href="/privacidade">termos de uso e a política de privacidade</a> da JLM.</span>
    </label>
    <span asp-validation-for="AcceptTerms" class="field-error"></span>

    <button type="submit" class="btn btn--gold btn--block btn--lg">
        Criar minha conta <svg class="icon"><use href="#i-arrow-right"></use></svg>
    </button>
</form>

<div class="auth-divider"><span>já tem conta?</span></div>
<a class="btn btn--ghost btn--block" href="/conta/entrar">Entrar na minha conta</a>

<p class="auth-card__foot">Seus dados estão protegidos conforme a LGPD. <a href="/privacidade">Saiba mais</a>.</p>
