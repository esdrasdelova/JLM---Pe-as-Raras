@model ProductDetailsViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.ShortDescription;
    ViewData["BodyClass"] = "page-product";
    var currentUrl = $"/produto/{product.Slug}";
    var gallery = Model.Gallery.Count > 0 ? Model.Gallery : new List<string> { product.ImageUrl };
    var sizes = product.SizeList;
    var colors = product.ColorList.ToList();
    var inStock = product.Stock > 0;
}

<section class="product">
    <div class="container">
        <nav class="breadcrumbs breadcrumbs--dark" aria-label="Trilha de navegação">
            <a href="/">Início</a><span>/</span>
            @if (product.Category is not null)
            {
                <a href="/@product.Category.Slug">@product.Category.Name</a><span>/</span>
            }
            <span aria-current="page">@product.Name</span>
        </nav>

        <div class="product__layout">
            <div class="product-gallery" data-gallery>
                <div class="product-gallery__thumbs" role="tablist" aria-label="Imagens do produto">
                    @for (var i = 0; i < gallery.Count; i++)
                    {
                        <button type="button" class="product-gallery__thumb @(i == 0 ? "is-active" : "")"
                                data-gallery-thumb="@gallery[i]" role="tab" aria-selected="@(i == 0 ? "true" : "false")"
                                aria-label="Ver imagem @(i + 1)">
                            <img src="@gallery[i]" alt="" loading="lazy" />
                        </button>
                    }
                </div>
                <div class="product-gallery__main">
                    <img src="@gallery[0]" alt="@product.Name" data-gallery-image data-zoom-image />
                    @if (product.HasDiscount)
                    {
                        <span class="product-gallery__badge">-@product.DiscountPercent%</span>
                    }
                    @if (product.Collection is not null)
                    {
                        <a class="product-gallery__collection" href="/colecoes/@product.Collection.Slug">
                            <svg class="icon"><use href="#i-layers"></use></svg> @product.Collection.Name
                        </a>
                    }
                    <button class="product-gallery__zoom" type="button" data-gallery-zoom aria-label="Ampliar imagem">
                        <svg class="icon"><use href="#i-search"></use></svg>
                    </button>
                </div>
            </div>

            <div class="product-info">
                <div class="product-info__head">
                    <span class="eyebrow">@(product.Collection?.Name ?? product.Category?.Name ?? "JLM")</span>
                    <h1>@product.Name</h1>
                    <div class="product-info__rating">
                        <div class="stars" aria-label="Avaliação @product.Rating.ToString("0.0") de 5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <svg class="icon @(i < Math.Round(product.Rating) ? "is-filled" : "")"><use href="#i-star"></use></svg>
                            }
                        </div>
                        <span>@product.Rating.ToString("0.0") · @product.ReviewCount avaliações</span>
                        <span class="product-info__sku">SKU @product.Sku</span>
                    </div>
                </div>

                <div class="product-info__price">
                    @if (product.HasDiscount)
                    {
                        <span class="price price--lg price--sale">@product.Price.ToBrl()</span>
                        <span class="price price--old">@product.ComparePrice.ToBrl()</span>
                        <span class="badge badge--sale">Economize @((product.ComparePrice!.Value - product.Price).ToBrl())</span>
                    }
                    else
                    {
                        <span class="price price--lg">@product.Price.ToBrl()</span>
                    }
                    <p>ou <strong>@product.Price.Installments(6)</strong> · <span class="text-gold">5% off no Pix</span></p>
                </div>

                <p class="product-info__short">@product.ShortDescription</p>

                <form action="/carrinho/adicionar" method="post" class="product-form" data-ajax-form data-add-to-cart data-product-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />

                    @if (sizes.Length > 0)
                    {
                        <fieldset class="option-group">
                            <legend>
                                Tamanho
                                <a href="/contato" class="option-group__help">Guia de tamanhos</a>
                            </legend>
                            <div class="option-grid">
                                @foreach (var size in sizes)
                                {
                                    <label class="option-chip">
                                        <input type="radio" name="size" value="@size" checked="@(size == sizes[0])" required />
                                        <span>@size</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }

                    @if (colors.Count > 0)
                    {
                        <fieldset class="option-group">
                            <legend>Cor <span data-color-label>@colors[0].Name</span></legend>
                            <div class="color-grid">
                                @foreach (var color in colors)
                                {
                                    <label class="color-option" title="@color.Name">
                                        <input type="radio" name="color" value="@color.Name" checked="@(color.Name == colors[0].Name)" />
                                        <span style="--swatch:@color.Hex" aria-hidden="true"></span>
                                        <em>@color.Name</em>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }

                    <div class="product-form__buy">
                        <div class="quantity" data-quantity>
                            <button type="button" data-quantity-minus aria-label="Diminuir quantidade">
                                <svg class="icon"><use href="#i-minus"></use></svg>
                            </button>
                            <input type="number" name="quantity" value="1" min="1" max="@Math.Max(1, product.Stock)" aria-label="Quantidade" />
                            <button type="button" data-quantity-plus aria-label="Aumentar quantidade">
                                <svg class="icon"><use href="#i-plus"></use></svg>
                            </button>
                        </div>
                        <button type="submit" class="btn btn--gold btn--lg product-form__submit" @(inStock ? "" : "disabled")>
                            @if (inStock)
                            {
                                <svg class="icon"><use href="#i-bag"></use></svg>
                                <span>Adicionar ao carrinho</span>
                            }
                            else
                            {
                                <span>Produto esgotado</span>
                            }
                        </button>
                        <button type="button" class="btn btn--dark btn--lg product-form__buynow" data-buy-now @(inStock ? "" : "disabled")>
                            Comprar agora
                        </button>
                    </div>

                    <div class="product-form__meta">
                        <span class="stock-pill @(product.Stock <= 5 ? "stock-pill--low" : "")">
                            <span></span>
                            @if (product.Stock <= 0)
                            {
                                <text>Esgotado</text>
                            }
                            else if (product.Stock <= 5)
                            {
                                <text>Últimas @product.Stock unidades</text>
                            }
                            else
                            {
                                <text>Em estoque · envio em 24h</text>
                            }
                        </span>
                    </div>
                </form>

                <form action="/favoritos/alternar" method="post" data-ajax-form data-wishlist-form class="wishlist-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <button type="submit" class="@(Model.IsWishlisted ? "is-active" : "")" data-wishlist-button>
                        <svg class="icon"><use href="#i-heart"></use></svg>
                        <span>@(Model.IsWishlisted ? "Nos favoritos" : "Salvar nos favoritos")</span>
                    </button>
                </form>

                <div class="product-benefits">
                    <div><svg class="icon"><use href="#i-truck"></use></svg><span><strong>Frete grátis</strong> acima de R$ 500</span></div>
                    <div><svg class="icon"><use href="#i-refresh"></use></svg><span><strong>30 dias</strong> para trocar</span></div>
                    <div><svg class="icon"><use href="#i-shield"></use></svg><span><strong>Compra</strong> 100% segura</span></div>
                </div>

                <div class="accordion" data-accordion>
                    <details open>
                        <summary>Descrição <svg class="icon"><use href="#i-chevron-down"></use></svg></summary>
                        <div class="accordion__body">
                            @foreach (var paragraph in product.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <p>@paragraph</p>
                            }
                        </div>
                    </details>
                    @if (!string.IsNullOrWhiteSpace(product.Composition))
                    {
                        <details>
                            <summary>Composição & medidas <svg class="icon"><use href="#i-chevron-down"></use></svg></summary>
                            <div class="accordion__body"><p>@product.Composition</p></div>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.CareInstructions))
                    {
                        <details>
                            <summary>Cuidados <svg class="icon"><use href="#i-chevron-down"></use></svg></summary>
                            <div class="accordion__body"><p>@product.CareInstructions</p></div>
                        </details>
                    }
                    <details>
                        <summary>Entrega & devolução <svg class="icon"><use href="#i-chevron-down"></use></svg></summary>
                        <div class="accordion__body">
                            <p>Enviamos para todo o Brasil em até 24h úteis após a confirmação do pagamento. Frete grátis em compras acima de R$ 500. Prazo de troca ou devolução: 30 dias corridos após o recebimento.</p>
                        </div>
                    </details>
                </div>

                <div class="product-share">
                    <span>Compartilhar</span>
                    <a href="https://wa.me/?text=@Uri.EscapeDataString($"Olha essa peça da JLM: {product.Name}")" target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp"><svg class="icon"><use href="#i-whatsapp"></use></svg></a>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram da JLM"><svg class="icon"><use href="#i-instagram"></use></svg></a>
                    <button type="button" data-copy-link aria-label="Copiar link"><svg class="icon"><use href="#i-copy"></use></svg></button>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.CompleteTheLook.Count > 0)
{
    <section class="section section--look">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Combinação JLM</span>
                    <h2 class="section-title">Complete <em>o look.</em></h2>
                </div>
                <a class="link-arrow" href="/acessorios">Ver acessórios <svg class="icon"><use href="#i-arrow-right"></use></svg></a>
            </div>
            <div class="product-grid product-grid--three">
                @foreach (var item in Model.CompleteTheLook)
                {
                    @await Html.PartialAsync("_ProductCard", item)
                }
            </div>
        </div>
    </section>
}

@if (Model.RelatedProducts.Count > 0)
{
    <section class="section section--related">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Você também pode gostar</span>
                    <h2 class="section-title">Da mesma <em>família.</em></h2>
                </div>
                <a class="link-arrow" href="/catalogo">Catálogo completo <svg class="icon"><use href="#i-arrow-right"></use></svg></a>
            </div>
            <div class="product-grid product-grid--four">
                @foreach (var item in Model.RelatedProducts)
                {
                    @await Html.PartialAsync("_ProductCard", item)
                }
            </div>
        </div>
    </section>
}
